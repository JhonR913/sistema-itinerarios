DATABASE_URL=postgresql://notif:@@NOTIFICATION_DB_PASSWORD@@@postgres-notification:5432/notification
RABBITMQ_URL=amqp://itinerarios:@@RABBITMQ_PASSWORD@@@rabbitmq:5672/
# --- Recordatorios (Sprint 6) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=itinerarios@localhost
# Hora de envio = 00:00 de la fecha del viaje (en esta zona) menos N horas de antelacion
REMINDER_TIMEZONE=America/Bogota
REMINDER_LEAD_HOURS=24
REMINDER_POLL_SECONDS=30
