JWT_SECRET=@@JWT_SECRET@@
DATABASE_URL=postgresql://auth:@@AUTH_DB_PASSWORD@@@postgres-auth:5432/auth
# --- Correo (desarrollo: Mailpit captura todo en http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=itinerarios@localhost
# SMTP_STARTTLS, SMTP_USER, SMTP_PASSWORD y COOKIE_SECURE los inyecta docker-compose desde
# prod.env en produccion (ver docs/despliegue.md); nunca se guardan en el repositorio.
