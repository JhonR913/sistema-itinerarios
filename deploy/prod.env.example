# Plantilla de configuracion de PRODUCCION. NO se copia al repositorio con valores reales:
# `scripts/configure-prod.sh` crea el archivo real (~/itinerarios-config/prod.env) preguntando
# los valores en tu terminal, sin mostrarlos.

# --- Correo (Gmail con contrasena de aplicacion) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=contrasena-de-aplicacion-de-16-letras
# Gmail reescribe el remitente a la cuenta autenticada: usa el mismo correo.
SMTP_FROM=tu-cuenta@gmail.com

# --- Cloudflare Tunnel (token del tunel; Zero Trust > Networks > Tunnels) ---
TUNNEL_TOKEN=token-del-tunel

# --- Valores fijos de produccion ---
COOKIE_SECURE=1
WEB_BIND=127.0.0.1
